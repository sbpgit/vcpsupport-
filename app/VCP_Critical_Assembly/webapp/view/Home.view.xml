<mvc:View controllerName="vcpapp.vcpcriticalcomp.controller.Home" xmlns:l="sap.ui.layout" xmlns:core="sap.ui.core" xmlns:f="sap.ui.layout.form" xmlns:ux="sap.uxap" xmlns:mvc="sap.ui.core.mvc" displayBlock="true" xmlns="sap.m" xmlns:m="sap.m" xmlns:t="sap.ui.table" xmlns:u="sap.ui.unified">
    <ux:ObjectPageLayout id="ObjectPageLayoutCCT"  showFooter="true" headerContentPinned="true" showTitleInHeaderContent="false" >
        <ux:headerTitle>
           <ux:ObjectPageDynamicHeaderTitle>
					<ux:expandedHeading>
						<!-- <HBox>
							<m:VariantManagement id="idMatList123CCT" select="handleSelectPress" save="onCreate"	manage="onManage" supportFavorites="false" 
							showFooter="true"	popoverTitle="My Views" items="{path: '/items12'}" creationAllowed="true" 
							supportPublic="true" supportApplyAutomatically="false" manageCancel="onManageCancel" cancel="onNameCancel" visible="true" >
							<items>
							<m:VariantItem key="{VARIANTID}" text="{VARIANTNAME}"  author="{USER}" visible="true" 
							remove="{path:'REMOVE', formatter:'.formatter.formatRemove'}" sharing="{path:'SCOPE', formatter:'.formatter.formatScope'}"
							changeable="{path:'CHANGE', formatter:'.formatter.formatChange'}" rename="false" enabled="{path:'ENABLE', formatter:'.formatter.formatEnable'}"/>
								</items>
						</m:VariantManagement>
						</HBox> -->
					</ux:expandedHeading>
					<ux:snappedHeading>
					</ux:snappedHeading>
					<ux:navigationActions>
						<Button class="classHdr" icon="sap-icon://sys-help" id="idNav3CCT" press="onNavPress" type="Emphasized" tooltip="Help Document"/>
					</ux:navigationActions>
				</ux:ObjectPageDynamicHeaderTitle>
        </ux:headerTitle>
        <ux:headerContent>
            <FlexBox wrap="Wrap" fitContainer="true">
                <l:Grid defaultSpan="XL3 L3 M6 S12">
                    <VBox>
                        <Label text="{i18n>compsearch}" />
                        <SearchField id="idCompSearchCCT" liveChange="onSearch" placeholder="Item no/ Assembly" />
                    </VBox>
                    <VBox>
                        <Label text="{i18n>loc}" required="true" />
                        <MultiInput id="idlocCCT" value="" placeholder="{i18n>loc}" showValueHelp="true" valueHelpOnly="true" valueHelpRequest="handleValueHelp" />
                    </VBox>
                    <VBox>
                        <Label text="{i18n>prod}" required="true" />
                        <MultiInput id="prodInputCCT" placeholder="{i18n>prod}" showValueHelp="true" valueHelpOnly="true" valueHelpRequest="handleValueHelp" tokenUpdate="handleTokenUpdate" />
                    </VBox>
                    <VBox>
                        <Label text="" />
                        <HBox>
                            <Button text="Go" type="Emphasized" press="onGetData" tooltip="Get data based on filters" class="sapUiTinyMarginEnd" />
                            <Button text="Reset" type="Transparent" press="onResetData" tooltip="Reset data" />
                            
                        </HBox>
                    </VBox>
                </l:Grid>
            </FlexBox>
        </ux:headerContent>
        <ux:sections>
            <ux:ObjectPageSection>
                <ux:subSections>
                    <ux:ObjectPageSubSection>
                        <ux:blocks>
                            <VBox>
                                <t:TreeTable id="idCriticalComp" visibleRowCount="20" enableSelectAll="false" 
                                rows="{path:'/results', parameters: {arrayNames:['children'],numberOfExpandedLevels: 1}}" selectionMode="None">
                                    <t:extension>
                                        <!-- <Toolbar class="sapMTBHeader-CTX">
                                            <SearchField id="idSearch" placeholder="Assembly/ Component" width="250px" liveChange="onSearch" />
                                        </Toolbar> -->
                                    </t:extension>
                                    <t:columns>
                                        <t:Column hAlign="Center" width="250px">
                                            <Label text="{i18n>assemb}" textAlign="Center" />
                                            <t:template>
                                                <ObjectAttribute title="{ASMB_DESC}" text="{ASSEMBLY}" visible="{_isParent}" />
                                                <!-- <Text text="{ASMB_DESC}: {ASSEMBLY} " visible="{_isParent}" /> -->
                                            </t:template>
                                        </t:Column>
                                        <t:Column hAlign="Center">
                                            <Label text="{i18n>item}" textAlign="Center" />
                                            <t:template>
                                                <Text text="{= parseInt(${ITEM_NUM}) }" visible="{_isParent}" />
                                                <!-- visible="{= ${children}.length === 0 ? true : !${_isParent}}"/> -->
                                            </t:template>
                                        </t:Column>
                                        <t:Column hAlign="Center">
                                            <Label text="{i18n>component}" textAlign="Center" />
                                            <t:template>
                                                <Text text="{COMPONENT}" visible="{= ${children}.length === 0 ? true : !${_isParent}}" />
                                            </t:template>
                                        </t:Column>
                                        <t:Column hAlign="Center">
                                            <Label text="{i18n>compdesc}" textAlign="Center" />
                                            <t:template>
                                                <Text text="{COMP_DESC}" visible="{= ${children}.length === 0 ? true : !${_isParent}}" />
                                            </t:template>
                                        </t:Column>
                                        <t:Column hAlign="Center" width="250px" id="criticalColumn" visible="false">
                                            <Text text="{i18n>critical}" />
                                            <t:template>
                                            <!-- <HBox visible="{_isParent}"> -->
                                            <HBox>
                                                <Switch type="AcceptReject" state="{= ${Flag} === 'X' ? true :  false }" enabled="true"
                                                         customTextOn="Critical" customTextOff="Non-Critical" change="onCriticalChange" 
                                                         tooltip="{= ${Flag} === 'X' ? 'Critical' :  'Non-Critical' }">
                                                    <layoutData> 
                                                        <FlexItemData growFactor="2" />
                                                    </layoutData>
                                                </Switch>
                                                </HBox>
                                            </t:template>
                                        </t:Column>
                                    </t:columns>
                                </t:TreeTable>
                                
                            </VBox>
                        </ux:blocks>
                    </ux:ObjectPageSubSection>
                </ux:subSections>
            </ux:ObjectPageSection>
        </ux:sections>
        <ux:footer>
            <m:OverflowToolbar>
                <m:ToolbarSpacer />
                <Button text="Reload Data" type="Emphasized" press="onRefresh" tooltip="Reload Data" class="sapUiLargeMarginBegin" />
            </m:OverflowToolbar>
        </ux:footer>
    </ux:ObjectPageLayout>
</mvc:View>
