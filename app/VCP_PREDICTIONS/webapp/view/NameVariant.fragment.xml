<core:FragmentDefinition id="_IDGenFragmentDefinition1PS" xmlns="sap.m" xmlns:core="sap.ui.core" xmlns:f="sap.ui.layout.form">
    <Dialog id="openDialogPS" title="Create Variant" afterClose="onAfterClose">
        <f:SimpleForm id="createVariantPS" visible="true" editable="true" layout="ResponsiveGridLayout" adjustLabelSpan="false" emptySpanL="6" columnsL="1">
            <f:content>
                <VBox id="_IDGenVBox123PS">
                    <VBox id="_IDGenVBox2PS">
                        <Label id="_IDGenLabel1PS" text="View:" />
                        <Input value="" id="idInputPS" liveChange="handleSearch1" valueStateText="The view name already exists.Please enter a different name."/>
                    </VBox>
                    <CheckBox id="_IDGenCheckBox1PS" text="Set as Default" />
                    <!-- <CheckBox id="_IDGenCheckBox2" text="Public" /> -->
                    <CheckBox id="_IDGenCheckBox3PS" text="Apply Automatically" visible="false" />
                </VBox>
            </f:content>
        </f:SimpleForm>
        <buttons>
            <Button id="idSaveBtnPS" text="Save" press="onCreate" type="Emphasized"/>
            <Button id="idCanBtnPS"  text="Close" press="onSaveClose" />
        </buttons>
    </Dialog>
</core:FragmentDefinition>
