<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core">
    <Dialog id="_IDGenDialog1PS" title="Manage Views" contentWidth="850px" titleAlignment="Center">
        <Toolbar id="IDGenToolbar1PS">
            <SearchField id="_IDGenSearchField1PS" width="100%" liveChange="handleSearch1" placeholder="View Name/User" />
        </Toolbar>
        <Table id="varNameListPS" items="{path: '/items1'}" >
            <columns>
                <Column id="_IDGenColumn1PS">
                    <Text id="_IDGenText1PS" text="View" />
                </Column>
                <!-- <Column id="_IDGenColumn2">
                    <Text id="_IDGenText2" text="Public/Private" />
                </Column> -->
                <Column id="_IDGenColumn3PS">
                    <Text id="_IDGenText3PS" text="Default" />
                </Column>
                <!-- <Column id="_IDGenColumn4">
                    <Text id="_IDGenText4" text="Default" />
                </Column> -->
                
                <Column id="_IDGenColumn6PS" width="300px">
                    <Text id="_IDGenText6PS" text="Created By" />
                </Column>
                <Column id="_IDGenColumn5PS" visible="false">
                    <Text id="_IDGenText5PS" text="Variant ID" />
                </Column>
                <Column id="_IDGenColumn7PS" visible="true" hAlign="End">
                    <Text id="_IDGenText7PS" text="" />
                </Column>
            </columns>
            <items>
                <ColumnListItem >
                    <cells>
                        <!-- <ObjectIdentifier title="{VARIANTNAME}" text="{APPLICATION_NAME}"  titleActive="true" titlePress="onTitlePress"/> -->
                        <!-- <Text id="_IDGenText9" text="{VARIANTID}" /> -->
                        <Text  text="{VARIANTNAME}" />
                        <!-- <Text id="_IDGenText11" text="{SCOPE}" /> -->
                        <RadioButton  selected="{= ${DEFAULT} === 'Y'}" />
                        <Text  text="{USER}" />
                        <Text  text="{VARIANTID}" />
                        <Button  icon="sap-icon://decline" visible="{=${VARIANTNAME}!=='Standard'}" press="onViewDelete" />
                        <!-- <Text id="_IDGenText14" text="{FIELD_CENTER}" /> -->
                    </cells>
                </ColumnListItem>
            </items>
        </Table>
        <buttons>
            <Button id="_IDGenButtPS" type='Emphasized' text="Save" press="onManage" />
            <Button id="IDGenButton2PS"  text="Close" press="handleManageClose" />
        </buttons>
    </Dialog>
</core:FragmentDefinition>
