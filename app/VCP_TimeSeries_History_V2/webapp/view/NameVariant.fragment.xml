<core:FragmentDefinition id="_IDGenFragmentDefinition1" xmlns="sap.m" xmlns:core="sap.ui.core" xmlns:f="sap.ui.layout.form">
    <Dialog id="openDialogTSH" title="Create Variant" afterClose="onAfterClose">
        <f:SimpleForm id="createVariantTSH" visible="true" editable="true" layout="ResponsiveGridLayout" adjustLabelSpan="false" emptySpanL="6" columnsL="1">
            <f:content>
                <VBox id="_IDGenVBox1TSH">
                    <VBox id="_IDGenVBox2TSH">
                        <Label id="_IDGenLabel1TSH" text="View:" />
                        <Input value="" id="idInputTSH" liveChange="checkName" valueStateText="The view name already exists.Please enter a different name."/>
                    </VBox>
                    <CheckBox id="_IDGenCheckBox1TSH" text="Set as Default" />
                    <!-- <CheckBox id="_IDGenCheckBox2" text="Public" /> -->
                    <CheckBox id="_IDGenCheckBox3TSH" text="Apply Automatically" visible="false" />
                </VBox>
            </f:content>
        </f:SimpleForm>
        <buttons>
            <Button id="idSaveBtnTSH" text="Save" press="onCreate" type="Emphasized"/>
            <Button id="idCanBtnTSH"  text="Close" press="onSaveClose" />
        </buttons>
    </Dialog>
</core:FragmentDefinition>
