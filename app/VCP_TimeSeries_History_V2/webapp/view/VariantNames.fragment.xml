<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core">
    <Dialog id="_IDGenDialog1TSH" title="Manage Views" contentWidth="850px" titleAlignment="Center">
        <Toolbar id="IDGenToolbar1TSH">
            <SearchField id="_IDGenSearchField1TSH" width="100%" liveChange="handleSearch" placeholder="View Name/User" />
        </Toolbar>
        <Table id="varNameListTSH" items="{path: '/items1'}" >
            <columns>
                <Column id="_IDGenColumn1TSH">
                    <Text id="_IDGenText1TSH" text="View" />
                </Column>
                <!-- <Column id="_IDGenColumn2">
                    <Text id="_IDGenText2" text="Public/Private" />
                </Column> -->
                <Column id="_IDGenColumn3TSH">
                    <Text id="_IDGenText3TSH" text="Default" />
                </Column>
                <!-- <Column id="_IDGenColumn4">
                    <Text id="_IDGenText4" text="Default" />
                </Column> -->
                
                <Column id="_IDGenColumn6TSH" width="300px">
                    <Text id="_IDGenText6TSH" text="Created By" />
                </Column>
                <Column id="_IDGenColumn5TSH" visible="false">
                    <Text id="_IDGenText5TSH" text="Variant ID" />
                </Column>
                <Column id="_IDGenColumn7TSH" visible="true" hAlign="End">
                    <Text id="_IDGenText7TSH" text="" />
                </Column>
            </columns>
            <items>
                <ColumnListItem >
                    <cells>
                        <!-- <ObjectIdentifier title="{VARIANTNAME}" text="{APPLICATION_NAME}"  titleActive="true" titlePress="onTitlePress"/> -->
                        <!-- <Text id="_IDGenText9" text="{VARIANTID}" /> -->
                        <Text  text="{VARIANTNAME}" />
                        <!-- <Text id="_IDGenText11" text="{SCOPE}" /> -->
                        <RadioButton  selected="{= ${DEFAULT} === 'Y'}" />
                        <Text  text="{USER}" />
                        <Text  text="{VARIANTID}" />
                        <Button  icon="sap-icon://decline" visible="{=${VARIANTNAME}!=='Standard'}" press="onViewDelete" />
                        <!-- <Text id="_IDGenText14" text="{FIELD_CENTER}" /> -->
                    </cells>
                </ColumnListItem>
            </items>
        </Table>
        <buttons>
            <Button id="_IDGenButtTSH" type='Emphasized' text="Save" press="onManage" />
            <Button id="IDGenButton2TSH"  text="Close" press="handleManageClose" />
        </buttons>
    </Dialog>
</core:FragmentDefinition>
