<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core">
    <Dialog title="Characteristics" contentWidth="40vw" contentHeight="auto" afterClose="closeBatchFragment" titleAlignment="Center">
        <Table id="idCharTableTSF" items="{path: '/items1' }">
                     <columns>
                      <Column  hAlign="Left">
                                <Text  text="Characteristic Name"/>
                            </Column>
                            <Column  hAlign="Center" width="auto">
                                <Text  text="Characteristic Value" />
                            </Column>  
                            <Column  hAlign="Center" width="auto">
                                <Text  text="Characteristic Value Description" />
                            </Column> 
                            <Column  hAlign="Center" width="auto">
                                <Text  text="Characteristic Value Number" />
                            </Column>                        
                        </columns>
                        <items>
                            <ColumnListItem>
                                <cells>
                                  <Text  text="{CHAR_NAME}" />
                                    <Text  text="{CHAR_VALUE}" />
                                    <Text  text="{CHARVAL_DESC}" />
                                    <Text  text="{CHARVAL_NUM}" />                                  
                                </cells>
                            </ColumnListItem>
                        </items>
                    </Table>
        <buttons>
            <!-- <Button id="idSaveBtn" text="Save" press="handler.createBatch" type="Emphasized" /> -->
            <Button id="empClosebtnTSF" text="Cancel" type="Transparent" press="closeBatchFragment" />
        </buttons>
    </Dialog>
</core:FragmentDefinition>
