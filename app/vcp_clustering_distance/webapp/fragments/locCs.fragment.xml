<core:FragmentDefinition
	xmlns="sap.m"
	xmlns:core="sap.ui.core">
	<SelectDialog
        id="idLocCsFrag"
		noDataText="No Locations Found"
		title="Demand Location"
		liveChange=".onSearchLocFrag"
		searchPlaceholder="Search Locations"
		confirm=".onLocCsValueHelpDialogClose"
		cancel=".onLocCsValueHelpDialogClose"
        rememberSelections="true"
		items="{
			path: '/items',
			sorter: {
				path: 'LOCATION_ID',
				descending: false
			}
		}">
		<StandardListItem
			title="{LOCATION_DESC}"
            description="{LOCATION_ID}"
		/>
	</SelectDialog>
</core:FragmentDefinition>