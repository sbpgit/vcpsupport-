<core:FragmentDefinition xmlns="sap.m"
    xmlns:core="sap.ui.core">
    <Dialog contentWidth="60%" id="idRowSelectFragCS" class="sapUiContentPadding" showHeader="false">
        <content>
            <Table id="idRowSelTableCS" items="{/items}" sticky="ColumnHeaders">
                <headerToolbar>
                    <OverflowToolbar>
                        <Title text="Primary ID Distances" level="H2" />
                        <ToolbarSpacer />
                        <!-- <Text text ="{= 'SourceClusterId: ' + ${/SOURCE_CLUSTER_ID} + ' | TargetClusterId: ' + ${/TARGET_CLUSTER_ID} }"/> -->
                    </OverflowToolbar>
                </headerToolbar>
                <columns>
                    <Column minScreenWidth="Tablet" demandPopin="true">
                        <Title text="Model Profile" />
                    </Column>

                    <Column minScreenWidth="Tablet" demandPopin="true">
                        <Title text="Source PID" />
                    </Column>

                    <Column minScreenWidth="Tablet" demandPopin="true">
                        <Title text="Target PID" />
                    </Column>

                    <Column minScreenWidth="Tablet" demandPopin="true">
                        <Title text="Distance" />
                    </Column>
                </columns>
                <items>
                    <ColumnListItem>
                        <cells>
                            <Text text="{MODEL_PROFILE}" />
                            <Text text="{SOURCE_PID}" />
                            <Text text="{TARGET_PID}" />
                            <Text text="{DISTANCE}" />
                        </cells>
                    </ColumnListItem>
                </items>
            </Table>
        </content>
        <footer>
			<Toolbar>
				<content>
					<Button text="Download" type="Emphasized" press="onDownload" />
					<ToolbarSpacer />
					<Button text="Cancel" press="onCancel" />
					
				</content>
			</Toolbar>
		</footer>
        <!-- <beginButton>
            <Button id="btn" text="Download" type="Emphasized" press="onDownload" />
        </beginButton>
        <endButton>
            <Button text="Cancel" press="onCancel" />
        </endButton> -->
    </Dialog>
</core:FragmentDefinition>
