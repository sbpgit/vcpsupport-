{
  "_version": "1.65.0",
  "sap.app": {
    "id": "vcpapp.vcpclusteringdistance",
    "type": "application",
    "i18n": "i18n/i18n.properties",
    "applicationVersion": {
      "version": "2512.01.01"
    },
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "resources": "resources.json",
    "sourceTemplate": {
      "id": "@sap/generator-fiori:basic",
      "version": "1.18.0",
      "toolsId": "52896aba-3277-4fa5-884c-7397e341c347"
    },
    "dataSources": {
      "mainService": {
        "uri": "/v2/catalog/",
        "type": "OData",
        "settings": {
          "annotations": [],
          "localUri": "localService/mainService/metadata.xml",
          "odataVersion": "2.0"
        }
      },
      "mainService2": {
        "uri": "/v2/pal/",
        "type": "OData",
        "settings": {
          "annotations": [],
          "localUri": "localService/metadata.xml",
          "odataVersion": "2.0"
        }
      }
    },
    "crossNavigation": {
      "inbounds": {
        "ClusteringDistance-DISPLAY": {
          "semanticObject": "ClusteringDistance",
          "action": "DISPLAY",
          "title": "Clustering Distance",
          "signature": {
            "parameters": {},
            "additionalParameters": "allowed"
          }
        }
      }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "icons": {
      "icon": "",
      "favIcon": "",
      "phone": "",
      "phone@2": "",
      "tablet": "",
      "tablet@2": ""
    },
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
  "sap.ui5": {
    "flexEnabled": false,
    "dependencies": {
      "minUI5Version": "1.120.41",
      "libs": {
        "sap.m": {},
        "sap.ui.core": {}
      }
    },
    "contentDensities": {
      "compact": true,
      "cozy": true
    },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "vcpapp.vcpclusteringdistance.i18n.i18n"
        }
      },
      "oGModel": {
        "type": "sap.ui.model.json.JSONModel",
        "settings": {
          "defaultBindingMode": "TwoWay"
        },
        "preload": true
      },
      "": {
        "dataSource": "mainService",
        "preload": true,
        "settings": {}
      },
      "palModel": {
        "dataSource": "mainService2",
        "preload": true,
        "settings": {
          "synchronizationMode": "None",
          "operationMode": "Server",
          "autoExpandSelect": true,
          "earlyRequests": true
        }
      }
    },
    "resources": {
      "css": [
        {
          "uri": "css/style.css"
        }
      ]
    },
    "routing": {
      "config": {
        "routerClass": "sap.m.routing.Router",
        "controlAggregation": "pages",
        "controlId": "app",
        "transition": "slide",
        "type": "View",
        "viewType": "XML",
        "path": "vcpapp.vcpclusteringdistance.view",
        "async": true
      },
      "routes": [
        {
          "name": "Home",
          "pattern": "",
          "target": [
            "Home"
          ]
        },
        {
          "name": "Detail",
          "pattern": "Detail",
          "target": [
            "Detail"
          ]
        }
      ],
      "targets": {
        "Home": {
          "viewId": "Home",
          "viewType": "XML",
          "name": "Home",
          "clearControlAggregation": true
        },
        "Detail": {
          "name": "Detail",
          "viewType": "XML",
          "viewId": "Detail",
          "clearControlAggregation": true
        }
      }
    },
    "rootView": {
      "viewName": "vcpapp.vcpclusteringdistance.view.App",
      "type": "XML",
      "id": "App",
      "async": true
    }
  },
  "sap.cloud": {
    "public": true,
    "service": "vcpsupport"
  },
  "sap.platform.cf": {
    "oAuthScopes": [
      "$XSAPPNAME.User",
      "$XSAPPNAME.admin"
 
    ]
  }
}
