<core:FragmentDefinition id="_IDGenFragmentDefinition1MV" xmlns="sap.m" xmlns:core="sap.ui.core" xmlns:f="sap.ui.layout.form">
    <Dialog id="openDialogMV" title="Create Variant" afterClose="onAfterClose">
        <f:SimpleForm id="createVariantMV" visible="true" editable="true" layout="ResponsiveGridLayout" adjustLabelSpan="false" emptySpanL="6" columnsL="1">
            <f:content>
                <VBox id="_IDGenVBox123MV">
                    <VBox id="_IDGenVBox2MV">
                        <Label id="_IDGenLabel1MV" text="View:" />
                        <Input value="" id="idInputMV" liveChange="handleSearch1" valueStateText="The view name already exists.Please enter a different name."/>
                    </VBox>
                    <CheckBox id="_IDGenCheckBox1MV" text="Set as Default" />
                    <!-- <CheckBox id="_IDGenCheckBox2" text="Public" /> -->
                    <CheckBox id="_IDGenCheckBox3MV" text="Apply Automatically" visible="false" />
                </VBox>
            </f:content>
        </f:SimpleForm>
        <buttons>
            <Button id="idSaveBtnMV" text="Save" press="onCreate" type="Emphasized"/>
            <Button id="idCanBtnMV"  text="Close" press="onSaveClose" />
        </buttons>
    </Dialog>
</core:FragmentDefinition>
