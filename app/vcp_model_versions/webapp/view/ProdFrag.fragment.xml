<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core">
	<SelectDialog contentHeight="50%"
		id="oProductMV"
		title="Product"
		items="{/aItems}"
		selectionChange="RequireProduct"
		liveChange=".handleSearch"
		confirm=".onProductSelect"
		cancel=".onProductSelect">
		<StandardListItem
			title="{PRODUCT_ID}"
			 />
	</SelectDialog>
</core:FragmentDefinition>